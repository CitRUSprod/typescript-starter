{
    "name": "typescript-starter",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "concurrently -k -n b,v -c blue,magenta -p [{name}] pnpm:dev:build pnpm:dev:check-types",
        "dev:build": "tsup --config configs/tsup/dev.ts --watch --onSuccess \"NODE_OPTIONS=--enable-source-maps pnpm start\"",
        "dev:check-types": "pnpm check-types -w --preserveWatchOutput",
        "build": "tsup --config configs/tsup/prod.ts",
        "check-types": "tsc --pretty --noEmit",
        "start": "dotenv node dist/main",
        "commit": "git-cz",
        "eslint": "eslint --color --no-error-on-unmatched-pattern",
        "eslint:fix": "pnpm eslint --fix",
        "eslint:all": "pnpm eslint \"**/*.{md,json,y?(a)ml,js,ts}\"",
        "eslint:fix:all": "pnpm eslint:all --fix",
        "lint": "pnpm eslint:all",
        "format": "pnpm eslint:fix:all",
        "validate": "pnpm check-types && pnpm lint",
        "prepare": "husky"
    },
    "packageManager": "pnpm@10.16.1",
    "engines": {
        "node": "22.19.0",
        "pnpm": "10.16.1"
    },
    "config": {
        "commitizen": {
            "path": "cz-customizable"
        },
        "cz-customizable": {
            "config": "./configs/commits/commitizen.cjs"
        }
    },
    "lint-staged": {
        "*.{md,json,y?(a)ml,js,ts}": "pnpm eslint:fix"
    },
    "devDependencies": {
        "@citrus-linting/eslint-config": "1.3.1",
        "@citrus-linting/prettier-config": "1.0.1",
        "@commitlint/cli": "20.1.0",
        "@commitlint/types": "20.0.0",
        "@stylistic/eslint-plugin": "5.5.0",
        "@total-typescript/ts-reset": "0.6.1",
        "@types/node": "24.10.1",
        "any-eslint-parser": "1.0.1",
        "commitizen": "4.3.1",
        "concurrently": "9.2.1",
        "cz-customizable": "7.5.1",
        "defu": "6.1.4",
        "dotenv-cli": "11.0.0",
        "dotenv-expand": "12.0.3",
        "eslint": "9.39.1",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-import": "2.32.0",
        "eslint-plugin-prettier": "5.5.4",
        "globals": "16.5.0",
        "husky": "9.1.7",
        "lint-staged": "16.2.6",
        "prettier": "3.6.2",
        "tsup": "8.5.1",
        "typescript": "5.9.3",
        "typescript-eslint": "8.46.4"
    },
    "dependencies": {
        "dotenv": "17.2.3",
        "tslib": "2.8.1"
    }
}
